<?xml version="1.0"?>
<!-- App web del Kindle (WAF) que muestra el dashboard sin la barra del
     navegador. Se instala en /var/local/mesquite/dashboard y se registra en
     /var/local/appreg.db como com.david.dashboard (ver ../dashboard.sh). -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:kindle="http://kindle.amazon.com/ns/widget-extensions"
    id="com.david.dashboard" version="1.0" viewmodes="maximized">

    <name xml:lang="en">Dashboard</name>
    <description xml:lang="en">Home dashboard</description>

    <content src="index.html" />

    <kindle:gestures>
        <kindle:param name="drag" value="yes" />
        <kindle:param name="tap" value="yes" />
    </kindle:gestures>

    <kindle:network>
        <kindle:asset key="enableCaching" value="false" />
    </kindle:network>

    <!-- Sin barra de búsqueda del sistema -->
    <kindle:chrome>
        <kindle:asset key="configureSearchBar" value="none" />
    </kindle:chrome>

    <kindle:messaging>
        <kindle:app name="com.lab126.appmgrd" value="yes" />
    </kindle:messaging>

    <feature name="http://kindle.amazon.com/apis" required="true">
        <param name="appmgr" value="yes" />
        <param name="net" value="yes" />
        <param name="gestures" value="yes" />
        <param name="chrome" value="yes" />
        <param name="device" value="yes" />
        <param name="viewport" value="yes" />
    </feature>

    <kindle:settings>
        <kindle:setting name="saveContext" value="no" />
    </kindle:settings>
</widget>
